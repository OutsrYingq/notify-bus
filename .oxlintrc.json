{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/json-schema/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-explicit-any": "warn",
    "eqeqeq": "error",
    "no-throw-literal": "error",
    // packages/web uses React 19 through Vite's automatic JSX runtime, so
    // `React` never has to be in scope. Left on, this rule produced 39 false
    // positives across main.tsx and pages/*.tsx and drowned out the four real
    // no-console warnings. oxlint's `settings.react.runtime` / `version` do not
    // affect it — only turning it off does.
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "packages/web/dist/",
    "packages/web/node_modules/",
    "data/",
    "dist/",
    "build/"
  ]
}
